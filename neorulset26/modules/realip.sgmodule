# Feishu applications use these shared ByteDance infrastructure domains.
[Ruleset FeishuSharedInfra]
DOMAIN-SUFFIX,snssdk.com
DOMAIN-SUFFIX,zijieapi.com
DOMAIN-SUFFIX,bytescm.com
DOMAIN-SUFFIX,ibytedapm.com
DOMAIN-SUFFIX,bytetcc.com
DOMAIN-SUFFIX,byteimg.com
DOMAIN-SUFFIX,bytedance.com
DOMAIN-SUFFIX,bytedns.net
DOMAIN-SUFFIX,oceanengine.com
DOMAIN-SUFFIX,yhgfb-cn-static.com
DOMAIN-SUFFIX,doubaocdn.com

# Only verified Feishu, Lark, and Doubao traffic is routed directly.
[Rule]
# Shared infrastructure used by the installed Feishu and Lark applications.
AND,((PROCESS-NAME,/Applications/Lark.app/),(RULE-SET,FeishuSharedInfra,extended-matching)),DIRECT
AND,((PROCESS-NAME,/Applications/Feishu.app/),(RULE-SET,FeishuSharedInfra,extended-matching)),DIRECT
# Product-qualified Feishu CDN and CNAME targets.
DOMAIN-WILDCARD,*.feishu.cn.*.cdnbuild.net,DIRECT
DOMAIN-SUFFIX,feishu.cn.queniusz.com,DIRECT
DOMAIN-WILDCARD,*.feishucdn.com.bytedns1.com,DIRECT
DOMAIN-WILDCARD,*.feishucdn.com.*.cdngslb.com,DIRECT
DOMAIN,l7-online-feishu-common.s.dsa.cdnbuild.net,DIRECT
DOMAIN,l7-online-creative-global-v4.s.dsa.cdnbuild.net,DIRECT
# Lark product CDN.
DOMAIN-SUFFIX,larksuitecdn.com,DIRECT
# Doubao product domain.
DOMAIN-SUFFIX,doubao.com,DIRECT
# Dedicated Feishu and Lark product rule set.
RULE-SET,https://raw.githubusercontent.com/yagami1997/Arclane/main/neorulset26/rules/feishu.list,DIRECT,extended-matching
