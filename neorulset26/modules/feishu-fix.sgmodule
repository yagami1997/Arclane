#!name=🪽 Feishu / Lark＋豆包 実 IP・DIRECT 接続
#!desc=🚀 Feishu / Lark と豆包の公式ドメインおよび CDN の DNS 応答を実 IP に保ち、製品・アプリ専用トラフィックのみを DIRECT 接続にします。｜v1.2.0｜更新: 2026-08-29 JST
#!system=mac
# 🏷️ バージョン: 1.2.0
# 📅 更新日: 2026-08-29 JST (Asia/Tokyo)

# 🧭 DNS / Fake IP 対策：製品専用ドメインと製品名を含む CNAME のみに限定
[General]
always-real-ip = %APPEND% doubao.com, *.doubao.com, feishu.net, *.feishu.net, feishu.cn, *.feishu.cn, feishucdn.com, *.feishucdn.com, feishu-3rd-party-services.com, *.feishu-3rd-party-services.com, feishuimg.com, *.feishuimg.com, feishuapp.cn, *.feishuapp.cn, getfeishu.cn, *.getfeishu.cn, feishupkg.com, *.feishupkg.com, larksuite.com, *.larksuite.com, larksuitecdn.com, *.larksuitecdn.com, larkoffice.com, *.larkoffice.com, larkenterprise.com, *.larkenterprise.com, kundou.cn, *.kundou.cn, feelgood.cn, *.feelgood.cn, baseopendev.com, *.baseopendev.com, aiforce.cloud, *.aiforce.cloud, aiforce.run, *.aiforce.run, *.feishu.cn.bytedns1.com, *.feishu.cn.bytedns3.com, *.feishu.cn.*.cdngslb.com, *.feishu.cn.*.cdnbuild.net, *.feishu.cn.queniusz.com, *.feishu.net.*.queniuck.com, *.feishucdn.com.bytedns1.com, *.feishucdn.com.*.cdngslb.com, feishuapp.cn.bytedns1.com, *.feishuapp.cn.bytedns3.com, getfeishu.cn.*.cdnbuild.net, *.getfeishu.cn.*.cdngslb.com, *.feishupkg.com.*.queniuck.com, *.kundou.cn.*.cdngslb.com, feelgood.cn.*.cdngslb.com, *.feelgood.cn.*.cdngslb.com, aiforce.cloud.bytedns3.com, *.aiforce.cloud.bytedns3.com, aiforce.run.bytedns3.com, *.aiforce.run.bytedns3.com, *.larksuite.com.ttdns2.com, *.larksuitecdn.com.ttdns2.com, *.larksuitecdn.com.edgesuite.net, *.larkoffice.com.*.cdnbuild.net, *.larkoffice.com.bytedns1.com, *.larkenterprise.com.bytedns3.com, *.doubao.com.bytedns1.com, *.doubao.com.bytedns3.com, *.doubao.com.*.cdnbuild.net, *.doubao.com.*.cdngslb.com, direct.frontier-doubao-broker-v4.*.bytelb.net, l7-online-feishu-common.s.dsa.cdnbuild.net, l7-online-creative-global-v4.s.dsa.cdnbuild.net, lf-cdn-tos.bytescm.com, lf3-cdn-tos.bytescm.com

# 🧩 Feishu アプリが利用する ByteDance 共通基盤（プロセス条件と組み合わせて使用）
[Ruleset FeishuSharedInfra]
DOMAIN-SUFFIX,snssdk.com
DOMAIN-SUFFIX,zijieapi.com
DOMAIN-SUFFIX,bytescm.com
DOMAIN-SUFFIX,ibytedapm.com
DOMAIN-SUFFIX,bytetcc.com
DOMAIN-SUFFIX,byteimg.com
DOMAIN-SUFFIX,bytedance.com
DOMAIN-SUFFIX,bytedns.net
DOMAIN-SUFFIX,oceanengine.com
DOMAIN-SUFFIX,yhgfb-cn-static.com
DOMAIN-SUFFIX,doubaocdn.com

# 🔀 製品ドメインと、Feishu アプリ内の ByteDance 共通基盤のみを DIRECT 接続
[Rule]
# 💬 Lark / Feishu アプリ内の ByteDance 共通基盤
AND,((PROCESS-NAME,/Applications/Lark.app/),(RULE-SET,FeishuSharedInfra,extended-matching)),DIRECT
AND,((PROCESS-NAME,/Applications/Feishu.app/),(RULE-SET,FeishuSharedInfra,extended-matching)),DIRECT
# 🧭 Feishu 名を含む CDN / CNAME
DOMAIN-WILDCARD,*.feishu.cn.*.cdnbuild.net,DIRECT
DOMAIN-SUFFIX,feishu.cn.queniusz.com,DIRECT
DOMAIN-WILDCARD,*.feishucdn.com.bytedns1.com,DIRECT
DOMAIN-WILDCARD,*.feishucdn.com.*.cdngslb.com,DIRECT
DOMAIN,l7-online-feishu-common.s.dsa.cdnbuild.net,DIRECT
DOMAIN,l7-online-creative-global-v4.s.dsa.cdnbuild.net,DIRECT
# 🌏 Lark 専用 CDN
DOMAIN-SUFFIX,larksuitecdn.com,DIRECT
# 🫛 豆包の公式ドメイン
DOMAIN-SUFFIX,doubao.com,DIRECT
# 📋 Feishu / Lark 専用ルールセット
RULE-SET,https://raw.githubusercontent.com/yagami1997/Arclane/main/neorulset26/rules/feishu.list,DIRECT,extended-matching
