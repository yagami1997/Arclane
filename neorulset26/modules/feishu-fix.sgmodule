#!name=🪽 Feishu / Lark 実 IP・DIRECT 接続
#!desc=🚀 Feishu / Lark の DNS 応答を実 IP のままに保ち、製品専用トラフィックを DIRECT 接続にします。
#!system=mac

# 🧭 DNS / Fake IP 対策
[General]
always-real-ip = %APPEND% feishu.cn, *.feishu.cn, feishucdn.com, *.feishucdn.com, larksuite.com, *.larksuite.com, larkoffice.com, *.larkoffice.com, feishu-3rd-party-services.com, *.feishu-3rd-party-services.com, l7-online-feishu-common.s.dsa.cdnbuild.net, lf-cdn-tos.bytescm.com, lf3-cdn-tos.bytescm.com, lf3-short.ibytedapm.com, mcs.snssdk.com, i.snssdk.com, mcs.zijieapi.com, *.bytedns.net, *.bytedns1.com, *.bytedns3.com, *.bytednsdoc.com, *.cdnbuild.net, *.cdngslb.com, *.queniusz.com, *.queniurc.com, *.queniuck.com, *.bytescm.com, *.bytetos.com, l7-online-creative-global-v4.s.dsa.cdnbuild.net

# 🔀 アプリと製品専用ドメインを DIRECT 接続
[Rule]
# 💬 Lark（国際版）
PROCESS-NAME,/Applications/Lark.app/,DIRECT
# 💬 Feishu（中国版）
PROCESS-NAME,/Applications/Feishu.app/,DIRECT
# 🌐 管理画面用 CDN
DOMAIN,l7-online-creative-global-v4.s.dsa.cdnbuild.net,DIRECT
# 📋 Feishu / Lark 専用ルールセット
RULE-SET,https://raw.githubusercontent.com/yagami1997/Arclane/main/neorulset26/rules/feishu.list,DIRECT,extended-matching
