#!name=📱 Feishu / Lark＋豆包 実 IP・DIRECT 接続
#!desc=🚀 iOS 上の Feishu / Lark と豆包の公式ドメインおよび CDN を実 IP と DIRECT 接続で安定化します。
#!system=ios

# 🧭 DNS / Fake IP 対策：製品専用ドメインと製品名を含む CNAME のみに限定
[General]
always-real-ip = %APPEND% doubao.com, *.doubao.com, feishu.net, *.feishu.net, feishu.cn, *.feishu.cn, feishucdn.com, *.feishucdn.com, feishu-3rd-party-services.com, *.feishu-3rd-party-services.com, feishuimg.com, *.feishuimg.com, feishuapp.cn, *.feishuapp.cn, getfeishu.cn, *.getfeishu.cn, feishupkg.com, *.feishupkg.com, larksuite.com, *.larksuite.com, larksuitecdn.com, *.larksuitecdn.com, larkoffice.com, *.larkoffice.com, larkenterprise.com, *.larkenterprise.com, kundou.cn, *.kundou.cn, feelgood.cn, *.feelgood.cn, baseopendev.com, *.baseopendev.com, aiforce.cloud, *.aiforce.cloud, aiforce.run, *.aiforce.run, *.feishu.cn.bytedns1.com, *.feishu.cn.bytedns3.com, *.feishu.cn.*.cdngslb.com, *.feishu.net.*.queniuck.com, feishuapp.cn.bytedns1.com, *.feishuapp.cn.bytedns3.com, getfeishu.cn.*.cdnbuild.net, *.getfeishu.cn.*.cdngslb.com, *.feishupkg.com.*.queniuck.com, *.kundou.cn.*.cdngslb.com, feelgood.cn.*.cdngslb.com, *.feelgood.cn.*.cdngslb.com, aiforce.cloud.bytedns3.com, *.aiforce.cloud.bytedns3.com, aiforce.run.bytedns3.com, *.aiforce.run.bytedns3.com, *.larksuite.com.ttdns2.com, *.larksuitecdn.com.ttdns2.com, *.larksuitecdn.com.edgesuite.net, *.larkoffice.com.*.cdnbuild.net, *.larkoffice.com.bytedns1.com, *.larkenterprise.com.bytedns3.com, *.doubao.com.bytedns1.com, *.doubao.com.bytedns3.com, *.doubao.com.*.cdnbuild.net, *.doubao.com.*.cdngslb.com, direct.frontier-doubao-broker-v4.*.bytelb.net, l7-online-feishu-common.s.dsa.cdnbuild.net, lf-cdn-tos.bytescm.com, lf3-cdn-tos.bytescm.com

# 🔀 製品専用ドメインを DIRECT 接続
[Rule]
# 🌏 Lark 専用 CDN
DOMAIN-SUFFIX,larksuitecdn.com,DIRECT
# 🫛 豆包の公式ドメイン
DOMAIN-SUFFIX,doubao.com,DIRECT
# 📋 Feishu / Lark 専用ルールセット
RULE-SET,https://raw.githubusercontent.com/yagami1997/Arclane/main/neorulset26/rules/feishu.list,DIRECT,extended-matching
